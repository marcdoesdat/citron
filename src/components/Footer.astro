---
/**
 * Footer.astro — Pied de page minimal, style éditorial.
 */
import Logo from './Logo.astro';
import { site } from '../data/site';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-line mt-16">
  <div class="max-w-5xl mx-auto px-6 py-16 space-y-10">

    <!-- Signature -->
    <div class="text-center space-y-5">
      <a href="/" class="inline-block" aria-label={`${site.person}, accueil`}>
        <Logo class="text-5xl sm:text-7xl" />
      </a>
      <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-muted">Création visuelle pour particuliers et professionnels</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 text-center md:text-left">
      <div class="space-y-4">
        <h3 class="text-xs font-medium tracking-[0.18em] uppercase text-fg">Navigation</h3>
        <nav class="space-y-2" aria-label="Liens du pied de page">
          <a href="/" class="block text-sm text-muted hover:text-citron transition-colors">Accueil</a>
          <a href="/portfolio/" class="block text-sm text-muted hover:text-citron transition-colors">Portfolio</a>
          <a href="/services/" class="block text-sm text-muted hover:text-citron transition-colors">Services & Tarifs</a>
          <a href="/contact/" class="block text-sm text-muted hover:text-citron transition-colors">Contact</a>
        </nav>
      </div>

      <div class="space-y-4">
        <h3 class="text-xs font-medium tracking-[0.18em] uppercase text-fg">Réseaux sociaux</h3>
        <div class="space-y-2">
          <a href={site.instagram.url} target="_blank" rel="noopener noreferrer" class="block text-sm text-muted hover:text-citron transition-colors">Instagram</a>
          <a href={site.youtube.url} target="_blank" rel="noopener noreferrer" class="block text-sm text-muted hover:text-citron transition-colors">YouTube</a>
          <a href={`mailto:${site.email}`} class="block text-sm text-muted hover:text-citron transition-colors">{site.email}</a>
        </div>
      </div>

      <div class="space-y-4">
        <h3 class="text-xs font-medium tracking-[0.18em] uppercase text-fg">Zone desservie</h3>
        <p class="text-sm text-muted leading-relaxed">
          Montréal et Rive-Nord.
        </p>
        <p class="text-xs text-subtle uppercase tracking-[0.12em]">
          Photographe portrait, corporatif et événementiel
        </p>
      </div>
    </div>

    <div class="pt-6 border-t border-line text-center space-y-2">
      <p class="text-xs text-subtle">&copy; {currentYear} {site.name}. Tous droits réservés.</p>
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        <a href="/mentions-legales/" class="inline-block text-xs text-subtle uppercase tracking-[0.12em] hover:text-citron transition-colors">Mentions légales</a>
        <a href="/politique-de-confidentialite/" class="inline-block text-xs text-subtle uppercase tracking-[0.12em] hover:text-citron transition-colors">Politique de confidentialité</a>
      </div>
    </div>

  </div>
</footer>
