---
import { site } from '../data/site';
import { serviceKinds, portraitServices, eventServices, corporateServices } from '../data/services';
import type { Service } from '../data/services';

interface Props {
  title: string;
  description: string;
  /** Le titre est déjà complet : ne pas y ajouter « | nom du site » */
  titleIsComplete?: boolean;
  ogImage?: string;
  canonicalPath?: string;
  /** Page à ne pas indexer (remerciement, 404) */
  noindex?: boolean;
}

const { title, description, titleIsComplete = false, ogImage, canonicalPath, noindex = false } = Astro.props;

const siteName   = site.name;
const siteUrl    = `${site.url}/`;
const fullTitle  = titleIsComplete || title === siteName ? title : `${title} | ${siteName}`;

const canonical  = new URL(canonicalPath ?? Astro.url.pathname, siteUrl).toString();
const defaultOgImage = new URL("/og-default.jpg", siteUrl).toString();
const ogImageUrl = ogImage ? new URL(ogImage, siteUrl).toString() : defaultOgImage;

const ogImageAlt = `${siteName} : photographe et vidéaste à Montréal`;

const riveNordCities = [
  "Montréal", "Terrebonne", "Laval", "Repentigny", "Mascouche",
  "Saint-Jérôme", "Blainville", "Mirabel", "Boisbriand", "Sainte-Thérèse",
  "Rosemère", "Bois-des-Filion", "Deux-Montagnes", "Saint-Eustache",
  "L'Assomption", "Joliette", "Lachenaie", "Charlemagne",
];

/** Offre schema.org d'un forfait (seulement ceux qui ont un montant) */
const toOffer = (service: Service) => ({
  "@type": "Offer",
  "itemOffered": {
    "@type": "Service",
    "name": service.title,
    "description": service.features.join(", "),
    "areaServed": "Montréal et Rive-Nord, Québec"
  },
  ...(service.showStartingFrom
    ? { "priceSpecification": { "@type": "PriceSpecification", "minPrice": service.amount, "priceCurrency": "CAD" } }
    : { "price": String(service.amount), "priceCurrency": "CAD" }),
});

const offerGroups = [
  { name: serviceKinds.portrait, services: portraitServices },
  { name: serviceKinds.event, services: eventServices },
  { name: serviceKinds.corporate, services: corporateServices },
].map(({ name, services }) => ({
  "@type": "OfferCatalog",
  "name": name,
  "itemListElement": services.filter((s) => s.amount !== undefined).map(toOffer),
}));

// Identique sur toutes les pages : c'est l'entreprise qui est décrite, pas la page.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "ProfessionalService"],
  "@id": `${siteUrl}#business`,
  "name": siteName,
  "description": site.description,
  "url": siteUrl,
  "image": defaultOgImage,
  "logo": new URL("/icon-512.png", siteUrl).toString(),
  "email": site.email,
  "telephone": site.phoneE164,
  "priceRange": "$",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Terrebonne",
    "addressRegion": "QC",
    "addressCountry": "CA"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 45.7059,
    "longitude": -73.6447
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday","Tuesday","Wednesday","Thursday",
      "Friday","Saturday","Sunday"
    ],
    "opens": "09:00",
    "closes": "23:59"
  },
  "areaServed": riveNordCities.map(city => ({
    "@type": "City",
    "name": city
  })),
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Services photographiques",
    "itemListElement": offerGroups
  },
  "sameAs": [
    site.instagram.url,
    site.youtube.url
  ]
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />

<!-- Géolocalisation -->
<meta name="geo.region" content="CA-QC" />
<meta name="geo.placename" content="Terrebonne, Québec" />
<meta name="geo.position" content="45.7059;-73.6447" />
<meta name="ICBM" content="45.7059, -73.6447" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:locale" content="fr_CA" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
