---
import Layout from '../layouts/Layout.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import SwipeGallery from '../components/SwipeGallery.astro';
import { Image } from 'astro:assets';
import alexPortrait from '../assets/alex-diotte.jpg';
import { photos, photoImage, shotTime } from '../data/photos';
import { featuredServices, serviceKinds } from '../data/services';
import { site } from '../data/site';

const previewImages = photos.map((p) => ({
  src: photoImage(p.file),
  alt: p.alt,
  caption: p.caption,
  meta: shotTime(p),
}));
---

<Layout
  title={site.homeTitle}
  titleIsComplete
  description={site.description}
>

  <!-- ═══ HERO — Image pleine page ═══════════════════════════════════════ -->
  <section class="home-hero grain relative w-full overflow-hidden bg-ink">
    <!-- Recadrage vertical dédié au mobile, 16:9 ailleurs -->
    <picture>
      <source media="(max-width: 767px)" srcset="/hero-mobile.webp" type="image/webp" />
      <source srcset="/hero.webp" type="image/webp" />
      <img
        src="/hero.jpg"
        alt="Fêtard qui crie face à l'objectif au milieu d'une foule serrée"
        width="2400"
        height="1350"
        loading="eager"
        decoding="sync"
        fetchpriority="high"
        class="home-hero-image absolute inset-0 w-full h-full object-cover"
      />
    </picture>
    <!-- Gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/45 to-transparent"></div>
    <!-- Contenu hero -->
    <div class="home-hero-copy absolute bottom-0 left-0 right-0 px-6 pt-8 sm:px-14 text-fg">
      <!-- Le h1 garde « photographe Montréal » pour le référencement ; la voix passe en grand -->
      <h1>
        <span class="block mb-4 font-mono text-[11px] sm:text-xs uppercase tracking-[0.2em] text-citron">
          Photographe et vidéaste à Montréal
        </span>
        <span class="block font-display text-[clamp(2.75rem,10vw,6.5rem)]">
          Le vrai vibe.<br />
          <span class="text-fg/55">Pas de sourires<br class="hidden sm:inline" /> forcés.</span>
        </span>
      </h1>
      <p class="mt-5 max-w-md text-sm sm:text-base text-fg/80 leading-relaxed">
        Shows, événements et portraits, capturés sur le vif et sans artifices.
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-x-8 gap-y-3">
        <a
          href="/contact/"
          class="inline-flex items-center justify-center px-6 py-3 min-h-11 bg-citron text-ink text-xs font-semibold uppercase tracking-[0.14em] rounded-sm hover:bg-fg transition-colors duration-200"
        >
          Réserver une date
        </a>
        <a
          href="/portfolio/"
          class="inline-flex items-center min-h-11 text-xs font-semibold uppercase tracking-[0.14em] text-fg hover:text-citron transition-colors duration-200"
        >
          Voir le travail&nbsp;→
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ APERÇU PORTFOLIO ════════════════════════════════════════════════ -->
  <section class="py-16 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="font-display text-5xl sm:text-7xl text-fg mb-4">Portfolio</h2>
      </div>
      <SwipeGallery images={previewImages} />
      <div class="text-center mt-12">
        <a
          href="/portfolio/"
          class="flex w-fit mx-auto items-center justify-center px-6 py-3 min-h-11 text-xs font-semibold tracking-[0.14em] uppercase text-fg border border-fg rounded-sm hover:bg-citron hover:text-ink hover:border-citron transition-colors duration-200"
        >
          Voir tout le portfolio
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ BIO ═════════════════════════════════════════════════════════════ -->
  <section class="relative z-10 bg-ink py-12 md:py-24 px-6">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 items-center">
      <div class="overflow-hidden">
        <Image
          src={alexPortrait}
          alt="Alex Diotte, photographe professionnel"
          width={600}
          widths={[400, 600, 900, 1200]}
          sizes="(min-width: 768px) 480px, 100vw"
          loading="lazy"
          decoding="async"
          class="w-full h-auto object-cover"
        />
      </div>
      <div class="space-y-6">
        <h2 class="font-display text-5xl sm:text-7xl text-fg">
          Bonjour, je suis<br/>Alex.
        </h2>
        <p class="text-muted leading-relaxed text-sm">
          <strong>Photographe et vidéaste depuis 2016</strong>, mon histoire avec l'image a commencé par un déclic lors d'un voyage à Cuba. Si la passion est née à ce moment-là, c'est en <strong>2020</strong> que j'ai fait le choix de m'y consacrer à <strong>100 %</strong>.
        </p>
        <p class="text-muted leading-relaxed text-sm">
          J'ai d'abord forgé mon œil au cœur de la scène musicale. Immortaliser <strong>l'énergie brute</strong> des foules dans les soirées dubstep et riddim m'a appris l'essentiel : réagir en une fraction de seconde, gérer un environnement sous pression et capturer l'instant <strong>sur le vif</strong>, sans artifices. C'est cette agilité que j'apporte aujourd'hui sur chaque plateau.
        </p>
        <p class="text-muted leading-relaxed text-sm">
          Des événements corporatifs aux projets scolaires, en passant par les vidéos promotionnelles, ma mission est de capturer le vrai <em>vibe</em>. Mon approche est <strong>100 % adaptée à vos objectifs</strong> : je peux livrer un rendu <strong>épuré et hautement professionnel</strong>, tout comme je peux déployer une <strong>direction artistique audacieuse et assumée</strong> si vous souhaitez une image de marque qui sort du lot.
        </p>
        <p class="text-muted leading-relaxed text-sm">
          Que ce soit en coulisses, lors d'un grand événement ou dans un moment d'intimité, je crée des images qui racontent votre histoire avec une <strong>émotion authentique</strong>.
        </p>
        <a
          href="/portfolio/"
          class="flex w-fit mx-auto items-center justify-center px-6 py-3 min-h-11 text-xs font-semibold tracking-[0.14em] uppercase text-fg border border-fg rounded-sm hover:bg-citron hover:text-ink hover:border-citron transition-colors duration-200"
        >
          Découvrir mon travail
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ SERVICES ════════════════════════════════════════════════════════ -->
  <section class="py-16 px-6 border-t border-line">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="font-display text-5xl sm:text-7xl text-fg mb-4">Services & Tarifs</h2>
        <p class="text-muted text-sm max-w-md mx-auto">
          Trois forfaits populaires pour portrait, événement et corporatif.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {featuredServices.map((service) => (
          <div class="service-card-item border border-line p-8 space-y-4 cursor-pointer transition-all duration-300">
            <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-subtle">{serviceKinds[service.icon]}</p>
            <h3 class="font-display text-2xl text-fg">{service.title}</h3>
            <div class="flex items-baseline gap-2">
              <p class="text-2xl font-bold text-fg">{service.price}</p>
              {service.showStartingFrom && <span class="text-sm text-muted">à partir de</span>}
            </div>
            <p class="text-sm text-muted">{service.summary}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-12">
        <a
          href="/services/"
          class="flex w-fit mx-auto items-center justify-center px-6 py-3 min-h-11 text-xs font-semibold tracking-[0.14em] uppercase text-fg border border-fg rounded-sm hover:bg-citron hover:text-ink hover:border-citron transition-colors duration-200"
        >
          Voir tous les services
        </a>
      </div>
    </div>
  </section>

  <InstagramFeed posts={[
    'https://www.instagram.com/p/DN_CcZmjttY/?img_index=1',
    'https://www.instagram.com/p/DTjIqmUEX8x/?img_index=3',
    'https://www.instagram.com/p/DO9ivZYDNLo/?img_index=1',
  ]} />

  <!-- ═══ CTA FINAL ═══════════════════════════════════════════════════════ -->
  <section class="py-24 px-6">
    <div class="max-w-5xl mx-auto text-center space-y-6">
      <h2 class="font-display text-5xl sm:text-7xl text-fg">
        Votre projet,<br /><span class="text-citron">sur le vif.</span>
      </h2>
      <p class="text-muted text-sm leading-relaxed max-w-lg mx-auto">
        Un show, un lancement, une séance portrait ou du contenu pour vos réseaux : écrivez-moi et on bâtit les images ensemble.
      </p>
      <a
        href="/contact/"
        class="flex w-fit mx-auto items-center justify-center px-6 py-3 min-h-11 text-xs font-semibold tracking-[0.14em] uppercase text-fg border border-fg rounded-sm hover:bg-citron hover:text-ink hover:border-citron transition-colors duration-200"
      >
        Prendre rendez-vous
      </a>
    </div>
  </section>


<style is:global>
  .home-hero-copy h1,
  .home-hero-copy p {
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.45);
  }

  .home-hero-copy {
    padding-bottom: max(2.5rem, env(safe-area-inset-bottom));
  }

  @media (min-width: 640px) {
    .home-hero-copy {
      padding-bottom: 3.5rem;
    }
  }

  /* Visage du sujet ≈ 55 % / 45 % de la photo */
  .home-hero-image {
    object-position: 55% 42%;
  }

  .home-hero {
    height: calc(100dvh - var(--header-height, 64px));
  }

  @media (max-width: 767px) {
    .home-hero-image {
      object-position: 50% 35%;
    }

    .home-hero {
      height: 100dvh;
      margin-top: calc(var(--header-height, 64px) * -1);
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .home-hero-image {
      object-position: 55% 40%;
    }
  }

  @supports not (height: 100dvh) {
    .home-hero {
      height: calc(100vh - var(--header-height, 64px));
    }

    @media (max-width: 767px) {
      .home-hero {
        height: 100vh;
      }
    }
  }

  .service-card-item {
    position: relative;
    overflow: hidden;
  }

  .service-card-item::after {
    content: 'en savoir plus';
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-citron);
    color: var(--color-ink);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .service-card-item:hover::after,
  .service-card-item.active::after {
    opacity: 1;
  }
</style>

<script>
  const serviceCards = document.querySelectorAll<HTMLDivElement>('.service-card-item');
  serviceCards.forEach(card => {
    card.addEventListener('click', () => {
      window.location.href = '/services/';
    });
    card.addEventListener('touchstart', () => {
      card.classList.add('active');
    });
    card.addEventListener('touchend', () => {
      setTimeout(() => card.classList.remove('active'), 300);
    });
  });
</script>

</Layout>
