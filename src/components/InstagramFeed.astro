---
import { site } from '../data/site';

interface Props {
  posts: string[];        // URLs des posts Instagram publics
  handle?: string;
}

const { posts, handle = site.instagram.handle } = Astro.props;
---

<section id="instagram" class="py-16 px-6 border-t border-line" data-instagram-feed>
  <div class="max-w-5xl mx-auto">
    <div class="flex items-baseline justify-between mb-10">
      <h2 class="font-display text-4xl sm:text-5xl text-fg">Instagram</h2>
      <a
        href={`https://www.instagram.com/${handle}/`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-medium tracking-[0.18em] uppercase text-muted hover:text-citron transition-colors"
      >
        @{handle}
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 items-start">
      {posts.map((url) => (
        <blockquote
          class="instagram-media !m-0 !min-w-0 !w-full"
          data-instgrm-permalink={url}
          data-instgrm-version="14"
          data-instgrm-captioned
        >
          <!-- Contenu de repli : remplacé par Instagram quand son script est chargé -->
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-48 items-center justify-center border border-line p-6 text-center text-xs font-medium tracking-[0.18em] uppercase text-muted transition-colors hover:border-citron hover:text-citron"
          >
            Voir cette publication sur Instagram
          </a>
        </blockquote>
      ))}
    </div>
  </div>
</section>

<script>
  // Le script d'Instagram ne se charge que lorsque la section approche de l'écran.
  // Module Astro : exécuté une seule fois même si le composant est inclus plusieurs fois.
  const sections = document.querySelectorAll('[data-instagram-feed]');
  let started = false;

  const loadEmbed = () => {
    if (started) return;
    started = true;
    const script = document.createElement('script');
    script.async = true;
    script.src = 'https://www.instagram.com/embed.js';
    script.addEventListener('load', () => {
      (window as unknown as { instgrm?: { Embeds: { process: () => void } } }).instgrm?.Embeds.process();
    });
    document.body.appendChild(script);
  };

  if (sections.length > 0) {
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            observer.disconnect();
            loadEmbed();
          }
        },
        { rootMargin: '600px' },
      );
      sections.forEach((section) => observer.observe(section));
    } else {
      loadEmbed();
    }
  }
</script>
