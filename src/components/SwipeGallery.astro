---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryItem {
  src: ImageMetadata;
  alt: string;
  /** Légende courte affichée sous la photo */
  caption?: string;
  /** Méta à droite de la légende (ex. heure de prise de vue) */
  meta?: string;
}

interface Props {
  images: GalleryItem[];
  count?: number;
}

const { images = [], count = 4 } = Astro.props;
// On passe toutes les images au HTML ; le JS en choisira `count` au hasard côté client
const galleryId = `swipe-gallery-${Math.random().toString(36).slice(2, 9)}`;
---

<div id={galleryId} class="-mx-6 px-6 md:mx-0 md:px-0">
  <div
    class="swipe-gallery-scrollbar flex overflow-x-auto snap-x snap-mandatory gap-4 pb-2 scroll-smooth md:grid md:grid-cols-2 lg:grid-cols-4 md:overflow-visible md:pb-0"
    data-swipe-rail
  >
    {images.map((image) => (
      <figure class="snap-center shrink-0 w-[85vw] md:w-auto" data-swipe-item>
        <Image
          src={image.src}
          alt={image.alt}
          width={640}
          height={800}
          fit="cover"
          widths={[320, 640, 960]}
          sizes="(min-width: 1024px) 240px, (min-width: 768px) 50vw, 85vw"
          loading="lazy"
          decoding="async"
          class="w-full aspect-[4/5] object-cover"
        />
        {image.caption && (
          <figcaption class="mt-3 flex items-baseline justify-between gap-3 font-mono text-[11px] uppercase tracking-[0.06em]">
            <span class="text-fg">{image.caption}</span>
            {image.meta && <span class="shrink-0 text-subtle">{image.meta}</span>}
          </figcaption>
        )}
      </figure>
    ))}
  </div>

  <div class="flex items-center justify-center pt-2 md:hidden" data-swipe-dots>
    {images.map((_, index) => (
      <button
        type="button"
        class="group grid h-6 w-6 place-items-center"
        data-swipe-dot={index}
        aria-label={`Voir la photo ${index + 1}`}
        aria-current={index === 0 ? 'true' : 'false'}
      >
        <span class={`block h-2.5 w-2.5 transition-colors duration-200 ${index === 0 ? 'bg-citron' : 'bg-subtle'}`}></span>
      </button>
    ))}
  </div>
</div>

<style>
  .swipe-gallery-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .swipe-gallery-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<script is:inline define:vars={{ galleryId, count }}>
  const galleryRoot = document.getElementById(galleryId);

  if (galleryRoot) {
    // ── Sélection aléatoire de `count` images au chargement ──────────────
    const allItems = Array.from(galleryRoot.querySelectorAll('[data-swipe-item]'));
    const allDots  = Array.from(galleryRoot.querySelectorAll('[data-swipe-dot]'));

    // Fisher-Yates shuffle sur les indices
    const indices = allItems.map((_, i) => i);
    for (let i = indices.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [indices[i], indices[j]] = [indices[j], indices[i]];
    }
    const chosen = new Set(indices.slice(0, count));

    // Cacher les éléments non choisis (photos + points)
    allItems.forEach((item, i) => { if (!chosen.has(i)) item.style.display = 'none'; });
    allDots.forEach((dot, i)   => { if (!chosen.has(i)) dot.style.display  = 'none'; });

    const rail  = galleryRoot.querySelector('[data-swipe-rail]');
    const items = allItems.filter((_, i) => chosen.has(i));
    const dots  = allDots.filter((_, i)  => chosen.has(i));

    const setActiveDot = (activeIndex) => {
      dots.forEach((dot, index) => {
        const isActive = index === activeIndex;
        const mark = dot.firstElementChild;
        mark.classList.toggle('bg-citron', isActive);
        mark.classList.toggle('bg-subtle', !isActive);
        dot.setAttribute('aria-current', isActive ? 'true' : 'false');
      });
    };

    const getNearestIndex = () => {
      const railCenter = rail.scrollLeft + rail.clientWidth / 2;
      let nearestIndex = 0;
      let minDistance = Number.POSITIVE_INFINITY;

      items.forEach((item, index) => {
        const itemCenter = item.offsetLeft + item.clientWidth / 2;
        const distance = Math.abs(itemCenter - railCenter);
        if (distance < minDistance) {
          minDistance = distance;
          nearestIndex = index;
        }
      });

      return nearestIndex;
    };

    const syncFromScroll = () => {
      setActiveDot(getNearestIndex());
    };

    rail.addEventListener('scroll', syncFromScroll, { passive: true });
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        const item = items[index];
        if (!item) return;
        rail.scrollTo({
          left: item.offsetLeft - (rail.clientWidth - item.clientWidth) / 2,
          behavior: 'smooth',
        });
        setActiveDot(index);
      });
    });

    syncFromScroll();
  }
</script>
