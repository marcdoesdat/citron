---
import Logo from './Logo.astro';
import { site } from '../data/site';

const navLinks = [
  { href: '/',          label: 'Accueil'   },
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/services/', label: 'Services'  },
  { href: '/contact/',  label: 'Contact'   },
];

const currentPath = Astro.url.pathname;
---

<header id="site-header" class="sticky top-0 z-50 bg-ink transition-[background-color,backdrop-filter] duration-300">
  <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">

    <!-- Logo gauche -->
    <a href="/" class="shrink-0 relative z-[60]" aria-label={`${site.person}, accueil`}>
      <Logo class="text-xl sm:text-2xl md:text-3xl" />
    </a>

    <!-- Nav desktop (droite) -->
    <nav aria-label="Navigation principale" class="hidden md:flex items-center gap-10">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class={`text-xs font-medium tracking-[0.18em] uppercase transition-colors duration-200 ${
            currentPath === href
              ? 'text-citron'
              : 'text-muted hover:text-citron'
          }`}
          aria-current={currentPath === href ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
      <a
        href="/#instagram"
        class="text-xs font-medium tracking-[0.18em] uppercase text-muted hover:text-citron transition-colors duration-200"
      >
        Instagram
      </a>
    </nav>

    <!-- Hamburger mobile (droite) -->
    <div class="md:hidden">
      <!-- Bouton hamburger / croix -->
      <button
        type="button"
        id="nav-toggle"
        class="relative z-[60] flex flex-col justify-center gap-[5px] w-8 h-8 cursor-pointer"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Ouvrir le menu"
      >
        <span class="nav-bar nav-bar-1 block h-[2px] w-full bg-fg origin-center"></span>
        <span class="nav-bar nav-bar-2 block h-[2px] w-full bg-fg"></span>
        <span class="nav-bar nav-bar-3 block h-[2px] w-2/3 ml-auto bg-citron origin-center"></span>
      </button>

      <!-- Overlay plein ecran : masqué (visibility) tant que le menu est fermé,
           ce qui sort ses liens de l'ordre de tabulation -->
      <nav
        id="mobile-nav"
        aria-label="Menu mobile"
        class="fixed inset-0 z-50 flex flex-col items-center justify-center gap-6
               bg-ink/96
               invisible opacity-0 pointer-events-none
               transition-[opacity,visibility] duration-200
               data-[open]:visible data-[open]:opacity-100 data-[open]:pointer-events-auto"
      >
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            class={`font-display text-5xl transition-colors duration-200 ${
              currentPath === href
                ? 'text-citron'
                : 'text-fg hover:text-citron'
            }`}
            aria-current={currentPath === href ? 'page' : undefined}
          >
            {label}
          </a>
        ))}
        <a
          href="/#instagram"
          class="font-display text-5xl text-fg hover:text-citron transition-colors duration-200"
        >
          Instagram
        </a>

        <!-- Infos de contact en bas -->
        <div class="absolute bottom-12 text-center space-y-1 font-mono">
          <a href={`mailto:${site.email}`} class="block text-xs tracking-[0.05em] text-muted hover:text-fg transition-colors">
            {site.email}
          </a>
          <p class="text-[11px] tracking-[0.15em] text-subtle uppercase">{site.city}</p>
        </div>
      </nav>
    </div>

  </div>
  <div class="border-b border-line"></div>
</header>

<script is:inline>
  const header = document.getElementById('site-header');
  const navToggle = document.getElementById('nav-toggle');

  const setHeaderHeight = () => {
    if (header) {
      document.documentElement.style.setProperty('--header-height', header.offsetHeight + 'px');
    }
  };

  if (header) {
    setHeaderHeight();
    window.addEventListener('resize', setHeaderHeight, { passive: true });

    const toggleHeaderState = () => {
      const isScrolled = window.scrollY > 8;
      header.classList.toggle('bg-ink/80', isScrolled);
      header.classList.toggle('backdrop-blur-md', isScrolled);
      header.classList.toggle('bg-ink', !isScrolled);
    };

    toggleHeaderState();
    window.addEventListener('scroll', toggleHeaderState, { passive: true });
  }

  // ── Menu mobile ─────────────────────────────────────────────────────────
  const mobileNav = document.getElementById('mobile-nav');
  const desktopQuery = window.matchMedia('(min-width: 768px)');

  const setMenu = (open, { restoreFocus = false } = {}) => {
    if (!navToggle || !mobileNav) return;
    navToggle.setAttribute('aria-expanded', String(open));
    navToggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    mobileNav.toggleAttribute('data-open', open);
    // Le flou de l'en-tête créerait un contexte pour le panneau fixe : on le coupe tant que le menu est ouvert
    header?.classList.toggle('menu-open', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
    // <main> et <footer> viennent après l'en-tête dans le document : on les cherche à chaque appel
    document.querySelectorAll('main, footer').forEach((el) => { el.inert = open; });
    if (!open && restoreFocus) navToggle.focus();
  };

  const isOpen = () => navToggle?.getAttribute('aria-expanded') === 'true';

  navToggle?.addEventListener('click', () => setMenu(!isOpen()));

  // Fermer le menu au clic sur un lien
  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  document.addEventListener('keydown', (event) => {
    if (!isOpen()) return;
    if (event.key === 'Escape') {
      setMenu(false, { restoreFocus: true });
    } else if (event.key === 'Tab') {
      // Garde le focus dans l'en-tête tant que le panneau est ouvert
      const stops = [...header.querySelectorAll('a[href], button')].filter((el) => el.offsetParent !== null || el.closest('#mobile-nav'));
      const first = stops[0];
      const last = stops[stops.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }
  });

  // Passer en mise en page bureau referme le menu
  desktopQuery.addEventListener('change', (event) => {
    if (event.matches) setMenu(false);
  });
</script>

<style>
  .nav-bar {
    transition: transform 200ms, opacity 150ms;
  }

  /* Hamburger -> croix */
  #nav-toggle[aria-expanded='true'] .nav-bar-1 {
    transform: translateY(7px) rotate(45deg);
  }

  #nav-toggle[aria-expanded='true'] .nav-bar-2 {
    opacity: 0;
  }

  #nav-toggle[aria-expanded='true'] .nav-bar-3 {
    width: 100%;
    transform: translateY(-7px) rotate(-45deg);
  }

  #site-header.menu-open {
    backdrop-filter: none;
  }
</style>
