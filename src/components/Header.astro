---
import Logo from './Logo.astro';
import { site } from '../data/site';

const navLinks = [
  { href: '/',          label: 'Accueil'   },
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/services/', label: 'Services'  },
  { href: '/contact/',  label: 'Contact'   },
];

const currentPath = Astro.url.pathname;
---

<header id="site-header" class="sticky top-0 z-50 bg-ink transition-[background-color,backdrop-filter] duration-300">
  <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">

    <!-- Logo gauche -->
    <a href="/" class="shrink-0 relative z-[60]" aria-label={`${site.person}, accueil`}>
      <Logo class="text-xl sm:text-2xl md:text-3xl" />
    </a>

    <!-- Nav desktop (droite) -->
    <nav aria-label="Navigation principale" class="hidden md:flex items-center gap-10">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class={`text-xs font-medium tracking-[0.18em] uppercase transition-colors duration-200 ${
            currentPath === href
              ? 'text-citron'
              : 'text-muted hover:text-citron'
          }`}
          aria-current={currentPath === href ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
      <a
        href="/#instagram"
        class="text-xs font-medium tracking-[0.18em] uppercase text-muted hover:text-citron transition-colors duration-200"
      >
        Instagram
      </a>
    </nav>

    <!-- Hamburger mobile (droite) -->
    <div class="md:hidden">
      <input type="checkbox" id="nav-toggle" class="sr-only peer" />

      <!-- Bouton hamburger / croix -->
      <label
        for="nav-toggle"
        class="relative z-[60] flex flex-col justify-center gap-[5px] w-8 h-8 cursor-pointer"
        aria-label="Ouvrir le menu de navigation"
      >
        <span class="block h-[2px] w-full bg-fg transition-transform duration-200 origin-center" id="bar1"></span>
        <span class="block h-[2px] w-full bg-fg transition-opacity duration-150" id="bar2"></span>
        <span class="block h-[2px] w-2/3 ml-auto bg-citron transition-transform duration-200 origin-center" id="bar3"></span>
      </label>

      <!-- Overlay plein ecran -->
      <nav
        id="mobile-nav"
        aria-label="Menu mobile"
        class="fixed inset-0 z-50 flex flex-col items-center justify-center gap-6
               bg-ink/96
               opacity-0 pointer-events-none
               transition-opacity duration-200
               peer-checked:opacity-100 peer-checked:pointer-events-auto"
      >
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            class={`font-display text-5xl transition-colors duration-200 ${
              currentPath === href
                ? 'text-citron'
                : 'text-fg hover:text-citron'
            }`}
            aria-current={currentPath === href ? 'page' : undefined}
          >
            {label}
          </a>
        ))}
        <a
          href="/#instagram"
          class="font-display text-5xl text-fg hover:text-citron transition-colors duration-200"
        >
          Instagram
        </a>

        <!-- Infos de contact en bas -->
        <div class="absolute bottom-12 text-center space-y-1 font-mono">
          <a href={`mailto:${site.email}`} class="block text-xs tracking-[0.05em] text-muted hover:text-fg transition-colors">
            {site.email}
          </a>
          <p class="text-[11px] tracking-[0.15em] text-subtle uppercase">{site.city}</p>
        </div>
      </nav>
    </div>

  </div>
  <div class="border-b border-line"></div>
</header>

<script is:inline>
  const header = document.getElementById('site-header');
  const navToggle = document.getElementById('nav-toggle');

  const setHeaderHeight = () => {
    if (header) {
      document.documentElement.style.setProperty('--header-height', header.offsetHeight + 'px');
    }
  };

  if (header) {
    setHeaderHeight();
    window.addEventListener('resize', setHeaderHeight, { passive: true });

    const toggleHeaderState = () => {
      const isScrolled = window.scrollY > 8;
      header.classList.toggle('bg-ink/80', isScrolled);
      header.classList.toggle('backdrop-blur-md', isScrolled);
      header.classList.toggle('bg-ink', !isScrolled);
    };

    toggleHeaderState();
    window.addEventListener('scroll', toggleHeaderState, { passive: true });
  }

  // Fermer le menu au clic sur un lien
  document.querySelectorAll('#mobile-nav a').forEach(link => {
    link.addEventListener('click', () => {
      if (navToggle) navToggle.checked = false;
    });
  });
</script>
