---
/**
 * portfolio.astro — Galerie complète en style masonry, légendée façon planche contact.
 * Les photos, légendes et métadonnées viennent de src/data/photos.ts.
 */
import Layout from '../layouts/Layout.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import { photos, photoImage, shotMeta } from '../data/photos';

const allImages = photos.map((p) => ({
  src: photoImage(p.file),
  alt: p.alt,
  category: p.category,
  caption: p.caption,
  meta: shotMeta(p),
}));

const categories = [
  { label: 'Tous', value: 'all' },
  { label: 'Portrait', value: 'portrait' },
  { label: 'Événementiel', value: 'evenementiel' },
];
---

<Layout
  title="Portfolio"
  description="Portfolio d'Alex Diotte, photographe portrait et événementiel à Montréal, Terrebonne et sur toute la Rive-Nord du Québec."
>

  <!-- En-tête de page -->
  <section class="py-20 px-6 text-center">
    <h1 class="font-display text-6xl sm:text-8xl text-fg mb-5">Portfolio</h1>
    <p class="text-muted text-sm max-w-md mx-auto">
      Des shows, des foules, des visages. Sous chaque photo : le moment exact où elle a été prise.
    </p>
  </section>

  <!-- Filtres de catégorie (cosmétiques — extensibles avec JS) -->
  <div class="flex flex-wrap justify-center gap-6 px-6 mb-12">
    {categories.map(({ label, value }, i) => (
      <button
        type="button"
        class={`text-xs font-medium tracking-[0.18em] uppercase transition-colors duration-200 pb-1 ${
          i === 0
            ? 'text-citron border-b border-citron'
            : 'text-muted hover:text-citron'
        }`}
        aria-pressed={i === 0 ? 'true' : 'false'}
        data-filter={value}
      >
        {label}
      </button>
    ))}
  </div>

  <!-- Galerie masonry -->
  <section class="px-6 pb-24 max-w-5xl mx-auto">
    <PhotoGallery images={allImages} />
  </section>

  <!-- CTA bas de page -->
  <section class="py-20 px-6 text-center">
    <h2 class="font-display text-4xl sm:text-5xl text-fg mb-4">
      Vous avez un projet en tête ?
    </h2>
    <p class="text-muted text-sm mb-8 max-w-sm mx-auto">
      Contactez-moi pour discuter de votre vision et obtenir un devis personnalisé.
    </p>
    <a
      href="/contact/"
      class="flex w-fit mx-auto items-center justify-center px-6 py-3 min-h-11 text-xs font-semibold tracking-[0.14em] uppercase text-fg border border-fg rounded-sm hover:bg-citron hover:text-ink hover:border-citron transition-colors duration-200"
    >
      Me contacter
    </a>
  </section>


<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-category]');
  const normalize = (value: string) =>
    value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase();

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter || 'all';

      // Mettre à jour l'état actif des boutons
      buttons.forEach(b => {
        b.classList.remove('text-citron', 'border-b', 'border-citron');
        b.classList.add('text-muted');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('text-citron', 'border-b', 'border-citron');
      btn.classList.remove('text-muted');
      btn.setAttribute('aria-pressed', 'true');

      // Afficher/masquer les photos
      items.forEach(item => {
        const itemCategory = normalize(item.dataset.category || '');
        const show = filter === 'all' || itemCategory === filter;
        item.hidden = !show;
      });
    });
  });
</script>

<script>
  // Visionneuse plein écran. Le module principal de PhotoSwipe et sa feuille de
  // style ne sont téléchargés qu'au premier clic ; sans JavaScript, chaque lien
  // ouvre simplement la grande image.
  import PhotoSwipeLightbox from 'photoswipe/lightbox';

  const gallery = document.querySelector<HTMLElement>('[data-photo-gallery]');

  if (gallery) {
    const lightbox = new PhotoSwipeLightbox({
      gallery,
      // Seulement les photos visibles : le filtre de catégories pose l'attribut hidden.
      children: 'figure:not([hidden]) a',
      pswpModule: () => import('photoswipe'),
      openPromise: () => import('photoswipe/photoswipe.css'),
      padding: { top: 48, bottom: 88, left: 0, right: 0 },
      bgOpacity: 1,
      closeTitle: 'Fermer (Échap)',
      zoomTitle: 'Zoom',
      arrowPrevTitle: 'Photo précédente',
      arrowNextTitle: 'Photo suivante',
      errorMsg: "Cette photo n'a pas pu être chargée.",
    });

    // Légende et ligne de méta, reprises de la figure de la vignette
    lightbox.on('uiRegister', () => {
      lightbox.pswp?.ui?.registerElement({
        name: 'photo-caption',
        order: 9,
        isButton: false,
        appendTo: 'root',
        onInit: (el, pswp) => {
          const render = () => {
            const figure = pswp.currSlide?.data.element?.closest('figure');
            const [plate, title, meta] = Array.from(
              figure?.querySelectorAll<HTMLElement>('figcaption > span') ?? [],
            ).map((part) => part.textContent ?? '');
            const line = (text: string | undefined, className: string) => {
              const span = document.createElement('span');
              span.textContent = text ?? '';
              span.className = className;
              return span;
            };
            el.replaceChildren(
              line([plate, title].filter(Boolean).join('  '), 'pswp-caption-title'),
              ...(meta ? [line(meta, 'pswp-caption-meta')] : []),
            );
          };
          pswp.on('change', render);
        },
      });
    });

    lightbox.init();
  }
</script>

<style is:global>
  .pswp__photo-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 0 24px 24px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.5;
    pointer-events: none;
  }
  .pswp-caption-title { color: var(--color-fg); }
  .pswp-caption-meta { color: var(--color-muted); }
</style>

</Layout>
