---
/**
 * Button.astro — Bouton réutilisable.
 * Rend un <a> si href est fourni, sinon un <button>.
 * Variantes : primary (fond citron) et secondary (contour).
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  type = 'button',
  class: className = '',
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 px-6 py-3 min-h-11 text-xs font-semibold uppercase tracking-[0.14em] rounded-sm transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-citron focus-visible:ring-offset-2 focus-visible:ring-offset-ink';

const variants = {
  primary:
    'bg-citron text-ink hover:bg-fg',
  secondary:
    'border border-line text-fg bg-transparent hover:border-citron hover:text-citron',
};

const classes = `${base} ${variants[variant]} ${className}`.trim();
---

{href ? (
  <a href={href} class={classes} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} {...rest}>
    <slot />
  </button>
)}
