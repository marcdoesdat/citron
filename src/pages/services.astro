---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { portraitServices, eventServices, corporateServices, faq } from '../data/services';
---

<Layout
  title="Services & Tarifs"
  description="Forfaits portrait, événement, corporatif et contenu réseaux sociaux à Montréal et sur la Rive-Nord."
>

  <!-- En-tête -->
  <section class="py-20 px-6 text-center">
    <h1 class="font-display text-6xl sm:text-8xl text-fg mb-4">Services & Tarifs</h1>
    <p class="text-muted text-sm max-w-md mx-auto leading-relaxed">
      Portrait, événement, corporatif et contenu réseaux sociaux : des forfaits clairs, flexibles et adaptés à vos objectifs.
    </p>
  </section>

  <!-- Grille Portrait / Réseaux sociaux -->
  <section class="px-6 pb-16 max-w-5xl mx-auto">
    <h2 class="font-display text-4xl sm:text-5xl text-fg mb-8 text-center">Portrait / Contenu Réseaux Sociaux</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {portraitServices.map((service) => (
        <ServiceCard {...service} />
      ))}
    </div>
  </section>

  <!-- Grille Événement -->
  <section class="px-6 pb-16 max-w-5xl mx-auto">
    <h2 class="font-display text-4xl sm:text-5xl text-fg mb-8 text-center">Événement</h2>
    <p class="text-muted text-sm max-w-xl mx-auto text-center mb-8">
      Anniversaire, corporatif et autres événements.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {eventServices.map((service) => (
        <ServiceCard {...service} />
      ))}
    </div>
  </section>

  <!-- Grille Corporatif -->
  <section class="px-6 pb-16 max-w-5xl mx-auto">
    <h2 class="font-display text-4xl sm:text-5xl text-fg mb-4 text-center">Corporatif & Image de marque</h2>
    <p class="text-muted text-sm max-w-2xl mx-auto text-center mb-8">
      Pour les professionnels, les PME et la création de banques d'images.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {corporateServices.map((service) => (
        <ServiceCard {...service} />
      ))}
    </div>
  </section>

  <!-- Extras -->
  <div class="max-w-5xl mx-auto px-6 mb-16 border-t border-line pt-8">
    <h2 class="font-display text-2xl text-fg mb-4 text-center">Extras 🍋</h2>
    <ul class="text-sm text-muted max-w-2xl mx-auto space-y-2">
      <li>+100 $ / heure supplémentaire</li>
      <li>+250 $ pour montage vidéo récap (1-2 min)</li>
      <li>+75 $ pour livraison rapide (2-3 jours)</li>
      <li>Imprimerie disponible sur demande</li>
      <li>50¢ / km en dehors de Montréal et Rive-Nord</li>
    </ul>
  </div>

  <!-- Section FAQ rapide -->
  <section class="py-16 px-6">
    <div class="max-w-3xl mx-auto">
      <h2 class="font-display text-4xl sm:text-5xl text-fg mb-10 text-center">Questions fréquentes</h2>

      <div class="space-y-6">
        {faq.map(({ q, a }) => (
          <div class="border-b border-line pb-6">
            <h3 class="font-medium text-fg mb-2">{q}</h3>
            <p class="text-sm text-muted leading-relaxed">{a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 px-6 text-center">
    <h2 class="font-display text-4xl sm:text-5xl text-fg mb-4">
      Prêt·e à commencer ?
    </h2>
    <p class="text-muted text-sm mb-8 max-w-sm mx-auto">
      Décrivez votre projet et je vous répondrai dans les 24h avec une proposition sur mesure.
    </p>
    <a
      href="/contact/"
      class="flex w-fit mx-auto items-center justify-center px-6 py-3 min-h-11 text-xs font-semibold tracking-[0.14em] uppercase text-fg border border-fg rounded-sm hover:bg-citron hover:text-ink hover:border-citron transition-colors duration-200"
    >
      Demander un devis gratuit
    </a>
  </section>

</Layout>
